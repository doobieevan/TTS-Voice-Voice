# TTS voice menu settings
LLM_PROVIDER=ollama
CHAT_URL=http://localhost:11434/v1/chat/completions
CHAT_MODEL=artifish/llama3.2-uncensored
CHAT_API_KEY=ollama
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
INPUT_DEVICE=1
PIPER_MODEL=piper-master/etc/test_voice.onnx
SAMPLE_RATE=16000
SILENCE_THRESHOLD=0.015
SILENCE_SECONDS=0.8
MAX_RECORD_SECONDS=20
SYSTEM_PROMPT=You are a concise, helpful voice assistant.
